# Generated image and history persistence
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai
MYSQL_USER=root
MYSQL_PASSWORD=change_me

# 1-100. Higher values preserve more detail but use more storage.
IMAGE_STORAGE_WEBP_QUALITY=90

# Optional outbound proxy for server-side fetch (Node fetch ignores system proxy).
# Set these if your relays are only reachable via a local proxy (e.g. Clash).
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Seed image provider credentials (server-side only).
STEP_API_KEY=
AIXORAS_API_KEY=
DEFAULT_API_KEY=
SENSENOVA_API_KEY=

# Admin login. Use independent, randomly generated values in production.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
