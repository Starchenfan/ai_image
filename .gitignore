# Dependencies
/node_modules/

# Next.js build output
/.next/
/.next-probe/
/.next.conflict-*/
/.next-analysis/
/out/

# Production output
/build/
/dist/
/public/generated-images/

# Test output
/coverage/
/playwright-report/
/test-results/
/blob-report/

# Local environment files
.env*
!.env.example

# TypeScript
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Deployment tools
/.vercel/

# Local tooling
/.run/
/.workbuddy/
/.studio/

# Vendored dependencies (.vendor/) — keep runtime + types, ignore build artifacts
/.vendor/**/*.d.ts.map
/.vendor/**/*.bak*
/.vendor/@xyflow/*/src/
/.vendor/**/rollup.config.js
/.vendor/**/postcss.config.js
/.vendor/**/tsconfig.json

# Editors and operating systems
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini
.history/
/.history/
.npm-cache/

